# Production environment variables
NODE_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.example.com  # Backend API URL
VITE_API_PORT=8000  # Backend API port

# Assets and CDN
VITE_ASSETS_URL=https://cdn.example.com/assets  # CDN URL

# Production Settings
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_DEBUG=false

# Analytics and Monitoring
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID= 