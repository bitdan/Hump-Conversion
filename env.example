# 环境配置示例文件
# 复制此文件为 .env.local 并根据需要修改

# Java API origin；同域反代时留空，接口本身已包含 /api/v1
VITE_API_URL=http://localhost:9999
VITE_API_PROXY_TARGET=http://localhost:9999

# SSE 基础 URL，留空表示走当前域名
VITE_API_BASE_URL=http://localhost:9999

# WebSocket 可按需使用 query token；SSE 默认使用 HttpOnly 登录 Cookie
VITE_WS_URL=ws://localhost:9999
VITE_WS_TOKEN_IN_QUERY=true
VITE_SSE_TOKEN_IN_QUERY=false

# 开发服务器端口
VITE_PORT=5173

# 生产环境 API URL (构建时使用)
# VITE_API_URL=https://tool.example.com
