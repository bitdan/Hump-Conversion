# Server Configuration
VITE_PORT=5173  # Frontend dev server port

# API Configuration
VITE_API_BASE_URL=http://localhost:9999  # Java backend API URL
VITE_API_PORT=9999  # Java backend API port

# Development Settings
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_DEBUG=true

# Assets
VITE_ASSETS_URL=http://localhost:5173/assets 

# API地址
VITE_API_URL=http://localhost:9999
VITE_API_PROXY_TARGET=http://localhost:9999

# WebSocket地址
VITE_WS_TOKEN_IN_QUERY=true
VITE_SSE_TOKEN_IN_QUERY=false
VITE_WS_URL=ws://localhost:9999 
